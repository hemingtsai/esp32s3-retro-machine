u16 main(void)
{
    u16 index = 0;
    u16 sum = 0;
    while (index < 5) {
        if (index == 1) {
            index += 1;
            continue;
        }
        if (index == 4) {
            index += 1;
        } else {
            sum += index;
        }
        index += 1;
    }
    return sum;
}
